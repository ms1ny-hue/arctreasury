# ArcTreasury environment. Copy to .env and fill. NEVER commit real secrets.

# --- Arc Testnet (public, safe to keep as-is) ---
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Execution mode ---
# "demo" = deterministic in-memory gateway, no real tx (safe default)
# "arc-testnet" = real Arc Testnet reads/writes (requires deployed contract + funded approver)
CHAIN_MODE=demo

# --- Deployed contract (fill after `pnpm contracts:deploy`) ---
TREASURY_EXECUTOR_ADDRESS=
# Demo vault the executor is allowed to fund (allowlisted destination)
DEMO_VAULT_ADDRESS=

# --- Signing (server-side only; used ONLY by deploy/exec scripts, never the browser) ---
# Deployer / approver key for the testnet demo. Testnet funds have no value.
# Leave blank in demo mode. NEVER put a mainnet key here.
DEPLOYER_PRIVATE_KEY=

# --- Optional: runtime AI explanations (P1). Blank => deterministic fallback text. ---
ANTHROPIC_API_KEY=

# --- Data freshness thresholds (seconds) ---
FRESHNESS_BALANCE_MAX_AGE=300
FRESHNESS_FORECAST_MAX_AGE=3600
